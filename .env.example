TRANSPORT=stdio
PORT=4000
HOST=0.0.0.0
MCP_ALLOWED_HOSTS=
MCP_SESSION_TTL_MS=300000
MCP_MAX_SESSIONS=500
MCP_MAX_BODY_BYTES=1048576
MCP_RATE_LIMIT_PER_MINUTE=60

# --- Quranpedia (https://api.quranpedia.net/v1) ---
# Base URL of the Quranpedia API.
QP_BASE_URL=https://api.quranpedia.net/v1
# Default tafsir book used by get_tafsir when book_id is omitted (1 = تيسير التفسير).
QP_DEFAULT_TAFSIR_BOOK_ID=1
# Upstream request timeout in milliseconds.
QP_FETCH_TIMEOUT_MS=30000
# Cache TTL for tafsir/translation/surah-info responses (static text).
QP_CACHE_TTL_MS=2592000000
# Persistent cache directory (survives restarts). Point it at a mounted
# volume (e.g. an rclone/Garage S3 mount) for durable caching. Omit for
# in-memory only.
QP_CACHE_DIR=
# Upper bound on in-memory cache entries (LRU-ish eviction of the oldest).
QP_CACHE_MAX_ENTRIES=5000
